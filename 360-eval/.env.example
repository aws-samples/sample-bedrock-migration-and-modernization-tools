# 360-eval OFFLINE config — copy to .env.local and edit.
# The offline build stores everything locally (SQLite + filesystem + Fernet).
# It still calls real AWS Bedrock for model inference (and real S3 for APO).

# --- Local app ---
LOCAL_DEV_MODE=true            # REQUIRED: runs evals as local subprocesses, injects a local user
LOCAL_DEV_USER=localdev        # the single local user
DATA_DIR=./.localdata          # where db.sqlite3, storage/ and secret.key live
S3_BUCKET=360eval-local        # label only — NOT a real bucket offline
ADMIN_USERS=localdev           # users allowed into the admin dashboard
CORS_ORIGINS=*

# --- AWS (still required for model inference) ---
AWS_REGION=us-east-1           # region for Bedrock inference + APO
# Provide AWS credentials via the default chain (env / ~/.aws / SSO).
# Bedrock models authenticate via SigV4 from these default creds — no Bedrock key needed.
# Other-provider keys (OpenAI/Gemini/Azure) + an optional Bedrock bearer token go in the
# UI Credentials tab — not here.

# --- APO only (optional) ---
# Bedrock Advanced Prompt Optimization can only read/write a REAL S3 bucket.
# Set this to a bucket you own to enable APO; leave blank to keep evals fully local
# (enabling APO without this will fail the eval with a clear message).
APO_BUCKET=
